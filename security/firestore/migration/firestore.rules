// PROPOSAL ONLY. Do not apply before /applications and staff scoring migration are verified.
// Legacy admin/manager claims retained; no owner/Google authorization is invented here.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() { return request.auth != null && request.auth.token.get('role', '') in ['admin', 'manager']; }
    function reader() { return request.auth != null && request.auth.token.get('role', '') in ['admin', 'manager', 'viewer']; }
    function admin() { return request.auth != null && request.auth.token.get('role', '') == 'admin'; }
    function exact(d, keys, count) { return d is map && d.size() == count && d.keys().hasOnly(keys); }
    function str(v, max) { return v is string && v.size() <= max; }
    function iso(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z'); }
    function integer(v) { return v is int && v >= 0 && v <= 1000000000000; }
    function signed(v) { return v is int && v >= -1000000000000 && v <= 1000000000000; }
    function metric(v) { return v is number && v >= 0 && v <= 100000000000000; }
    function signedMetric(v) { return v is number && v >= -100000000000000 && v <= 100000000000000; }
    function status(v) { return v in ['new','review','shortlist','watchlist','more_info','approved','rejected','archived']; }
    function performance(v) { return v in ['HIGH','GOOD','AVERAGE','LOW']; }
    function rating(v) { return v is int && v >= 0 && v <= 5; }
    function evaluation(e) {
      return e is map && e.keys().hasOnly(['brandFit','contentQuality','credibility','reliability','potential','strategicValue','updatedAt'])
        && rating(e.get('brandFit',0)) && rating(e.get('contentQuality',0))
        && rating(e.get('credibility',0)) && rating(e.get('reliability',0))
        && rating(e.get('potential',0)) && rating(e.get('strategicValue',0))
        && iso(e.updatedAt);
    }
    function metrics(d) {
      return exact(d, ['views','netFollowers','interactions','accountsReached'], 4)
        && integer(d.views) && signed(d.netFollowers) && integer(d.interactions) && integer(d.accountsReached);
    }
    function nullableInteger(v) { return v == null || integer(v); }
    function nullableSigned(v) { return v == null || signed(v); }
    function score100(v) { return v is int && v >= 0 && v <= 100; }
    // Scoring v2: five values. Before a correction any value may be missing (legacy documents);
    // after it only accountsReached may be null (optional, never replaced by views).
    function previousValues(p) {
      return exact(p, ['followers','views','netFollowers','interactions','accountsReached'], 5)
        && nullableInteger(p.followers) && nullableInteger(p.views) && nullableSigned(p.netFollowers)
        && nullableInteger(p.interactions) && nullableInteger(p.accountsReached);
    }
    function newValues(n) {
      return exact(n, ['followers','views','netFollowers','interactions','accountsReached'], 5)
        && integer(n.followers) && integer(n.views) && signed(n.netFollowers)
        && integer(n.interactions) && nullableInteger(n.accountsReached);
    }
    // Four-value corrections from the previous panel stay valid during the rollout.
    function correction(c, d) {
      return exact(c, ['correctedAt','correctedBy','previousValues','newValues','note'], 5)
        && iso(c.correctedAt) && c.correctedBy == 'staff' && str(c.note,2000)
        && ((metrics(c.previousValues) && metrics(c.newValues)
            && c.newValues.views == d.views && c.newValues.netFollowers == d.netFollowers
            && c.newValues.interactions == d.interactions && c.newValues.accountsReached == d.accountsReached)
          || (previousValues(c.previousValues) && newValues(c.newValues)
            && c.newValues.followers == d.followers && c.newValues.views == d.views
            && c.newValues.netFollowers == d.netFollowers && c.newValues.interactions == d.interactions
            && c.newValues.accountsReached == d.get('accountsReached', null)));
    }
    // Append-only history: earlier entries unchanged, new last entry equal to the new correction.
    // A legacy single correction may be carried over as the first entry.
    function history(h, d) {
      let old = resource.data.get('insightsHistory', null);
      let previous = resource.data.get('insightsCorrection', null);
      return h is list && h.size() >= 1 && h.size() <= 50 && h[h.size()-1] == d.insightsCorrection
        && ((old == null && h.size() == 1 && previous == null)
          || (old == null && h.size() == 2 && previous != null && h[0] == previous)
          || (old != null && old is list && h.size() == old.size() + 1 && h[0:old.size()] == old));
    }
    function staffUpdate(d) {
      let c = d.diff(resource.data).affectedKeys();
      return c.hasOnly(['status','notes','creatorCode','evaluation','followers','views','netFollowers','interactions','accountsReached','insightsCorrection','insightsHistory',
          'socialScore','perfLevel','erRate','reachRate','growthRate',
          'scoringVersion','engagementRate','engagementScore','visibilityScore','reachEngagementRate','lowBase','updatedAt'])
        && iso(d.updatedAt) && changedFields(c, d);
    }
    // Checks grouped by field family; a group is evaluated only when one of its fields changed,
    // keeping every request (denials included) within the expression budget.
    function changedFields(c, d) {
      return (c.hasAny(['status','notes','creatorCode','evaluation']) ? management(c, d) : true)
        && (c.hasAny(['followers','views','netFollowers','interactions','accountsReached']) ? counts(c, d) : true)
        && (c.hasAny(['socialScore','perfLevel','erRate','reachRate','growthRate']) ? previousScore(c, d) : true)
        && (c.hasAny(['scoringVersion','engagementRate','engagementScore','visibilityScore','reachEngagementRate','lowBase']) ? currentScore(c, d) : true)
        && (c.hasAny(['insightsCorrection','insightsHistory']) ? corrections(c, d) : true);
    }
    function management(c, d) {
      return (!c.hasAny(['status']) || status(d.status))
        && (!c.hasAny(['notes']) || str(d.notes,10000))
        && (!c.hasAny(['creatorCode']) || str(d.creatorCode,120))
        && (!c.hasAny(['evaluation']) || evaluation(d.evaluation));
    }
    function counts(c, d) {
      return (!c.hasAny(['followers']) || integer(d.followers))
        && (!c.hasAny(['views']) || integer(d.views))
        && (!c.hasAny(['netFollowers']) || signed(d.netFollowers))
        && (!c.hasAny(['interactions']) || integer(d.interactions))
        && (!c.hasAny(['accountsReached']) || nullableInteger(d.accountsReached));
    }
    // Fields of the previous model, still written by the previous panel during the rollout.
    function previousScore(c, d) {
      // null: punteggio v2 non disponibile (zero visualizzazioni).
      return (!c.hasAny(['socialScore']) || d.socialScore == null || score100(d.socialScore))
        && (!c.hasAny(['perfLevel']) || performance(d.perfLevel))
        && (!c.hasAny(['erRate']) || metric(d.erRate))
        && (!c.hasAny(['reachRate']) || metric(d.reachRate))
        && (!c.hasAny(['growthRate']) || signedMetric(d.growthRate));
    }
    function currentScore(c, d) {
      return (!c.hasAny(['scoringVersion']) || d.scoringVersion == 3)
        && (!c.hasAny(['engagementRate']) || d.engagementRate == null || metric(d.engagementRate))
        && (!c.hasAny(['engagementScore']) || d.engagementScore == null || score100(d.engagementScore))
        && (!c.hasAny(['visibilityScore']) || d.visibilityScore == null || score100(d.visibilityScore))
        && (!c.hasAny(['reachEngagementRate']) || d.reachEngagementRate == null || metric(d.reachEngagementRate))
        && (!c.hasAny(['lowBase']) || d.lowBase is bool);
    }
    function corrections(c, d) {
      return (!c.hasAny(['insightsCorrection']) || correction(d.insightsCorrection,d))
        && (!c.hasAny(['insightsHistory']) || (c.hasAny(['insightsCorrection']) && history(d.insightsHistory,d)));
    }
    match /candidature/{id} {
      // Server REST writes authenticated with IAM bypass these client rules.
      allow create: if false;
      allow get, list: if reader();
      allow update: if staff() && staffUpdate(request.resource.data);
      allow delete: if admin();
    }
    match /settings/scoring {
      allow get: if reader();
      // Frontend saves through authenticated POST /admin/scoring, never client set.
      // IAM server writes bypass Rules; verify endpoint auth/CORS and staging before activation.
      allow create, update, delete: if false;
    }
    // No client access to idempotency records, auth metadata, settings/config or other paths.
  }
}
