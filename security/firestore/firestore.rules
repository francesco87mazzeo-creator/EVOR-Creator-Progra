rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authorization is exclusively based on Firebase ID-token claims.
    // Google sign-in alone grants no role. Server/Admin SDK bypasses these rules.
    function staff() { return request.auth != null && request.auth.token.get('role', '') in ['admin', 'manager']; }
    // Viewer reads applications but never receives management write permissions.
    function reader() { return request.auth != null && request.auth.token.get('role', '') in ['admin', 'manager', 'viewer']; }
    function admin() { return request.auth != null && request.auth.token.get('role', '') == 'admin'; }
    function exact(d, keys) { return d is map && d.keys().hasOnly(keys) && d.keys().hasAll(keys); }
    function str(v, max) { return v is string && v.size() <= max; }
    function required(v, max) { return str(v, max) && v.matches('(?s).*[^ \t\r\n].*'); }
    function iso(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z'); }
    function integer(v) { return v is int && v >= 0 && v <= 1000000000000; }
    function signed(v) { return v is int && v >= -1000000000000 && v <= 1000000000000; }
    function metric(v) { return v is number && v >= 0 && v <= 100000000000000; }
    function signedMetric(v) { return v is number && v >= -100000000000000 && v <= 100000000000000; }
    function url(v) { return str(v, 2048) && (v == '' || v.matches('https?://[^ \t\r\n]+')); }
    function image(v) { return str(v, 700000) && (v == '' || v.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')); }
    function status(v) { return v in ['new','review','shortlist','watchlist','more_info','approved','rejected','archived']; }
    function performance(v) { return v in ['HIGH','GOOD','AVERAGE','LOW']; }
    function derived(d) {
      return d.socialScore is int && d.socialScore >= 0 && d.socialScore <= 100
        && performance(d.perfLevel) && required(d.bandLabel, 120)
        && metric(d.erRate) && metric(d.reachRate) && signedMetric(d.growthRate);
    }
    function rating(v) { return v is int && v >= 0 && v <= 5; }
    function evaluation(e) {
      return e is map && e.keys().hasOnly(['brandFit','contentQuality','credibility','reliability','potential','strategicValue','updatedAt'])
        && rating(e.get('brandFit',0)) && rating(e.get('contentQuality',0))
        && rating(e.get('credibility',0)) && rating(e.get('reliability',0))
        && rating(e.get('potential',0)) && rating(e.get('strategicValue',0))
        && iso(e.updatedAt);
    }
    function metrics(d) {
      return exact(d,['views','netFollowers','interactions','accountsReached'])
        && integer(d.views) && signed(d.netFollowers) && integer(d.interactions) && integer(d.accountsReached);
    }
    function nullableNumber(v) { return v == null || (v is number && v >= -1000000000000 && v <= 1000000000000); }
    function ocrNumber(f) {
      return exact(f,['value','visibility']) && nullableNumber(f.value)
        && f.visibility in ['complete','partial','not_visible'];
    }
    function ocrText(f) {
      return exact(f,['value','visibility','truncated'])
        && (f.value == null || str(f.value,200))
        && f.visibility in ['complete','partial','not_visible'] && f.truncated is bool;
    }
    function insight(s) {
      return s == null || (exact(s,['screenType','views','netFollowers','interactions','accountsReached'])
        && s.screenType in ['insights_ok','dashboard_wrong','uncertain']
        && ocrNumber(s.views) && ocrNumber(s.netFollowers)
        && ocrNumber(s.interactions) && ocrNumber(s.accountsReached));
    }
    function conflict(c) {
      return exact(c,['key','valueA','valueB'])
        && c.key in ['views','netFollowers','interactions','accountsReached']
        && nullableNumber(c.valueA) && nullableNumber(c.valueB);
    }
    function conflicts(c) {
      return c is list && c.size() <= 4
        && (c.size() < 1 || conflict(c[0])) && (c.size() < 2 || conflict(c[1]))
        && (c.size() < 3 || conflict(c[2])) && (c.size() < 4 || conflict(c[3]));
    }
    function ocrInsights(o) {
      return o == null || (exact(o,['screenshot1','screenshot2','merged','conflicts','readAt'])
        && insight(o.screenshot1) && insight(o.screenshot2)
        && exact(o.merged,['views','netFollowers','interactions','accountsReached'])
        && nullableNumber(o.merged.views) && nullableNumber(o.merged.netFollowers)
        && nullableNumber(o.merged.interactions) && nullableNumber(o.merged.accountsReached)
        && conflicts(o.conflicts) && iso(o.readAt));
    }
    function ocrProfile(o) {
      return o == null || (exact(o,['result','readAt']) && iso(o.readAt)
        && exact(o.result,['screenType','displayName','username','followers'])
        && o.result.screenType in ['profile_ok','wrong_screen','uncertain']
        && ocrText(o.result.displayName) && ocrText(o.result.username) && ocrNumber(o.result.followers));
    }
    function applicationKeys(d) { return exact(d, ["fullName", "email", "city", "country", "otherProfileCategory", "instagram", "tiktok", "screenshotName", "screenshotName2", "contentUrl1", "contentUrl2", "contentUrl3", "threeWords", "contentType", "whatToTransmit", "whyFollow", "brandCollabDetails", "motivation", "brandLike", "contentIntegration", "athleteImage", "valueBeyondContent", "howWouldTell", "scenarioBrandContent", "badContentReaction", "analysisElements", "brandMeaning", "boughtProducts", "improvements", "extra", "instagramHandle", "instagramUrl", "tiktokHandle", "tiktokUrl", "hasBrandCollabs", "buildWithoutEarnings", "contentPerMonth", "hasRoutine", "followsGuidelines", "availEvents", "availShooting", "availUgc", "availRawFiles", "age", "isAdult", "privacyConsent", "profileCategories", "followers", "tiktokFollowers", "views", "netFollowers", "interactions", "accountsReached", "screenshotData", "screenshotData2", "profileScreenshotData", "ocrInsights", "ocrProfile", "schemaVersion", "date", "updatedAt", "status", "notes", "creatorCode", "evaluation", "socialScore", "perfLevel", "bandLabel", "erRate", "reachRate", "growthRate"]); }
    function texts0(d) { return required(d.fullName, 199)
      && required(d.email, 199)
      && required(d.city, 200)
      && required(d.country, 200)
      && str(d.otherProfileCategory, 200)
      && required(d.instagram, 200)
      && str(d.tiktok, 200)
      && str(d.screenshotName, 255)
      && str(d.screenshotName2, 255)
      && url(d.contentUrl1); }
    function texts1(d) { return url(d.contentUrl2)
      && url(d.contentUrl3)
      && required(d.threeWords, 120)
      && required(d.contentType, 600)
      && required(d.whatToTransmit, 600)
      && required(d.whyFollow, 600)
      && str(d.brandCollabDetails, 600)
      && required(d.motivation, 900)
      && required(d.brandLike, 600)
      && required(d.contentIntegration, 900); }
    function texts2(d) { return str(d.athleteImage, 900)
      && str(d.valueBeyondContent, 900)
      && str(d.howWouldTell, 900)
      && str(d.scenarioBrandContent, 900)
      && str(d.badContentReaction, 900)
      && str(d.analysisElements, 900)
      && required(d.brandMeaning, 900)
      && str(d.boughtProducts, 120)
      && str(d.improvements, 600)
      && str(d.extra, 600); }
    function texts3(d) { return str(d.instagramHandle, 200)
      && url(d.instagramUrl)
      && str(d.tiktokHandle, 200)
      && url(d.tiktokUrl); }
    function answers(d) { return d.hasBrandCollabs in ["yes", "no"]
      && d.buildWithoutEarnings in ["yes", "yes_conditions", "depends", "paid_only"]
      && d.contentPerMonth in ["lt1", "1-2", "3-4", "5+", "depends"]
      && d.hasRoutine in ["yes", "building", "no"]
      && d.followsGuidelines in ["yes", "mostly", "no"]
      && d.availEvents in ["yes", "no", "maybe"]
      && d.availShooting in ["yes", "no", "maybe"]
      && d.availUgc in ["yes", "no", "maybe"]
      && d.availRawFiles in ["yes", "no", "maybe"]
      && (d.hasBrandCollabs != 'yes' || required(d.brandCollabDetails,600))
      && ( !('altro' in d.profileCategories) || required(d.otherProfileCategory,200)); }
    function application(d) {
      return applicationKeys(d) && texts0(d) && texts1(d) && texts2(d) && texts3(d) && answers(d)
        && d.fullName.size() > 1
        && d.email.matches('[^ \t\r\n@]+@[^ \t\r\n@]+[.][A-Za-z]{2,}')
        && d.age is int && d.age >= 18 && d.age <= 99
        && d.isAdult == true && d.privacyConsent == true
        && d.profileCategories is list && d.profileCategories.size() >= 1 && d.profileCategories.size() <= 8
        && d.profileCategories.toSet().size() == d.profileCategories.size()
        && d.profileCategories.hasOnly(['creator','coach','agonista','non_agonista','lifestyle','palestra','professionista','altro'])
        && integer(d.followers) && integer(d.tiktokFollowers)
        && integer(d.views) && signed(d.netFollowers) && integer(d.interactions) && integer(d.accountsReached)
        && image(d.screenshotData) && d.screenshotData != '' && image(d.screenshotData2) && image(d.profileScreenshotData)
        && d.screenshotData.size()+d.screenshotData2.size()+d.profileScreenshotData.size() <= 900000
        && ocrInsights(d.ocrInsights) && ocrProfile(d.ocrProfile)
        && d.schemaVersion == 4 && iso(d.date) && d.updatedAt == d.date
        && d.status == 'new' && d.notes == '' && d.creatorCode == '' && d.evaluation == {}
        && derived(d);
    }
    // Preserve original application and OCR evidence, including on legacy documents.
    // Validate only changed management fields; do not force a legacy migration.
    function correction(c, d) {
      return exact(c,['correctedAt','correctedBy','previousValues','newValues','note'])
        && iso(c.correctedAt) && c.correctedBy == 'staff'
        && metrics(c.previousValues) && metrics(c.newValues) && str(c.note,2000)
        && c.newValues.views == d.views && c.newValues.netFollowers == d.netFollowers
        && c.newValues.interactions == d.interactions && c.newValues.accountsReached == d.accountsReached;
    }
    function staffUpdate(d) {
      let c = d.diff(resource.data).affectedKeys();
      return c.hasOnly(['status','notes','creatorCode','evaluation','views','netFollowers','interactions','accountsReached','insightsCorrection','socialScore','perfLevel','erRate','reachRate','growthRate','updatedAt'])
        && iso(d.updatedAt)
        && (!c.hasAny(['status']) || status(d.status))
        && (!c.hasAny(['notes']) || str(d.notes,10000))
        && (!c.hasAny(['creatorCode']) || str(d.creatorCode,120))
        && (!c.hasAny(['evaluation']) || evaluation(d.evaluation))
        && (!c.hasAny(['views']) || integer(d.views))
        && (!c.hasAny(['netFollowers']) || signed(d.netFollowers))
        && (!c.hasAny(['interactions']) || integer(d.interactions))
        && (!c.hasAny(['accountsReached']) || integer(d.accountsReached))
        && (!c.hasAny(['socialScore']) || (d.socialScore is int && d.socialScore >= 0 && d.socialScore <= 100))
        && (!c.hasAny(['perfLevel']) || performance(d.perfLevel))
        && (!c.hasAny(['erRate']) || metric(d.erRate))
        && (!c.hasAny(['reachRate']) || metric(d.reachRate))
        && (!c.hasAny(['growthRate']) || signedMetric(d.growthRate))
        && (!c.hasAny(['insightsCorrection']) || correction(d.insightsCorrection,d));
    }
    function thresholds(t) {
      return exact(t,['avg','good','excellent']) && metric(t.avg) && metric(t.good) && metric(t.excellent)
        && t.avg > 0 && t.avg < t.good && t.good < t.excellent;
    }
    function band(b) {
      return exact(b,['label','max','er','reach','growth']) && required(b.label,120)
        && thresholds(b.er) && thresholds(b.reach) && thresholds(b.growth);
    }
    function level(l, v) {
      return exact(l,['v','l','min','c']) && l.v == v && required(l.l,120)
        && l.min is int && l.min >= 0 && l.min <= 100
        && l.c is string && l.c.matches('#[A-Fa-f0-9]{6}');
    }
    function scoring(d) {
      return exact(d,['version','weights','levels','bands']) && d.version == 2
        && exact(d.weights,['er','reach','growth'])
        && metric(d.weights.er) && d.weights.er <= 100
        && metric(d.weights.reach) && d.weights.reach <= 100
        && metric(d.weights.growth) && d.weights.growth <= 100
        && d.weights.er+d.weights.reach+d.weights.growth > 0
        && d.levels is list && d.levels.size() == 4
        && level(d.levels[0],'HIGH') && level(d.levels[1],'GOOD')
        && level(d.levels[2],'AVERAGE') && level(d.levels[3],'LOW')
        && d.levels[0].min > d.levels[1].min && d.levels[1].min > d.levels[2].min
        && d.levels[2].min > d.levels[3].min && d.levels[3].min == 0
        && d.bands is list && d.bands.size() == 5
        && band(d.bands[0]) && band(d.bands[1]) && band(d.bands[2]) && band(d.bands[3]) && band(d.bands[4])
        && integer(d.bands[0].max) && d.bands[0].max > 0
        && integer(d.bands[1].max) && d.bands[1].max > d.bands[0].max
        && integer(d.bands[2].max) && d.bands[2].max > d.bands[1].max
        && integer(d.bands[3].max) && d.bands[3].max > d.bands[2].max
        && d.bands[4].max == null;
    }
    match /candidature/{id} {
      allow create: if application(request.resource.data);
      allow get, list: if reader();
      allow update: if staff() && staffUpdate(request.resource.data);
      allow delete: if admin();
    }
    // Entire document is public: no credentials or private settings belong here.
    match /settings/scoring {
      allow get: if true;
      allow create, update: if admin() && scoring(request.resource.data);
    }
    // No list of settings, config access, subcollections or other paths granted.
  }
}
